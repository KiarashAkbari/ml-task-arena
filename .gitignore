# Raw and generated data must never enter git history (Delivery Guide §4.7).
# The pipeline creates these directories at runtime from an empty folder.
data/raw/
data/curated/*
# The curated dataset is committed compressed: 105.9 MiB raw exceeds
# GitHub's 100 MiB per-file limit. `gunzip -k` restores it byte-for-byte.
!data/curated/cases.csv.gz
data/raw_archived/

# Generated delivery folder (AGENTS.md section 6). Built from this tree by
# scripts/build_delivery.py; the source files are the only copy in git.
stage-1-kiarash-akbari/

# Virtual environments
.venv/
venv/

# Python artifacts
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Notebooks
.ipynb_checkpoints/

# Local run artifacts
fetch.log
fetch.pid

# OS / editor noise
.DS_Store
